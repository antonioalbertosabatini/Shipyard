# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Without the Supabase variables Shipyard runs in local-only mode (IndexedDB, no account).

# Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → Publishable key (the legacy `anon` key also works).
# Never put the secret / service_role key here: it would be shipped in the client bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: base URL used in auth emails (sign-up confirmation, password reset).
# Defaults to the current origin (e.g. http://localhost:5173). Must be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
# VITE_AUTH_REDIRECT_URL=

# Optional: `hash` for file-based shells (Electron, Capacitor); defaults to browser history.
# VITE_ROUTER_MODE=hash
