// Cloudflare Workers static assets deploy; `name` must match the Worker in the dashboard.
{
  "name": "shipyard",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes such as /projects/:id.
    "not_found_handling": "single-page-application",
  },
}
